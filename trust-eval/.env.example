# Claude API key used by the LLM-judge evaluators. Without it, only the
# deterministic rule evaluators run and every verdict is PARTIAL.
ANTHROPIC_API_KEY=

# Optional: override the judge model (defaults to claude-opus-5-5).
JUDGE_MODEL=

# Optional: Cloudflare Turnstile bot protection for the public /try page.
# When TURNSTILE_SECRET_KEY is set, /api/evaluate rejects requests without a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
